# ==============================================================================
# Syncopated Context Compiler - Environment Configuration
# ==============================================================================

# Project & Deployment
PROJECT_NAME=syncopated-context-compiler
APP_PORT=3000
HOST=0.0.0.0

# Network & Service Discovery
# In rootless Podman/Docker containers, use host.containers.internal to reach services on host.
OLLAMA_BASE_URL=http://host.containers.internal:11434
VITE_SFL_API=http://host.containers.internal:3001

# Optional Containerized Ollama Port (used only with *-ollama profiles)
CONTAINER_OLLAMA_PORT=11435

# LLM Provider API Keys (Server-side proxy)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
